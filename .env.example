# Postgres service. Copy this file to .env before `docker compose up`.
POSTGRES_USER=prospector
POSTGRES_PASSWORD=prospector
POSTGRES_DB=prospector
POSTGRES_PORT=5432

# App and Alembic. Use localhost when the process runs on the host.
# Keep the user, password, and database name in sync with the values above.
DATABASE_URL=postgresql+psycopg://prospector:prospector@localhost:5432/prospector

# Pytest creates this database when it is missing, migrates it, and empties it
# at the start of each run. It must be a different database from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://prospector:prospector@localhost:5432/prospector_test

FIRECRAWL_API_KEY=
X_BEARER_TOKEN=
# Slack bot token and signing secret turn on commands and digests.
# SLACK_APP_TOKEN (xapp-) turns on Socket Mode. Leave it empty to use HTTP at /slack/events.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
OPENAI_API_KEY=
# LangGraph extraction model. Use a provider prefix, for example openai:gpt-5.4-mini.
# Set that provider's API key when it is not covered by OPENAI_API_KEY.
EXTRACTION_MODEL=openai:gpt-6-luna
